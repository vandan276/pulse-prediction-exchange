{
  "buildCommand": "VITE_STANDALONE=true npm --prefix client run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm --prefix client install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/payments/deposit/:id/status", "destination": "/api/payments/deposit-status?id=:id" },
    { "source": "/api/payments/history/:userId", "destination": "/api/payments/history?userId=:userId" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
